# polly API environment template. Copy to `.env` and fill in.
#   cp .env.example .env

# Postgres connection string.
DATABASE_URL=postgresql://USER@localhost:5432/polly_dev

# Better Auth signing secret — at least 32 chars. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
BETTER_AUTH_SECRET=

# Public base URL the auth handler is served from.
BETTER_AUTH_URL=http://localhost:3001

# Envelope-encryption master key: 32 bytes, hex-encoded (64 hex chars).
# Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Treat this like a production secret — rotating it orphans every stored key.
ENCRYPTION_MASTER_KEY=

# Origin of the Expo web build (used for CORS + trusted auth origins).
WEB_ORIGIN=http://localhost:8081

PORT=3001

# Which Kalshi deployment the public market-data client + poller talk to.
#   demo | production  (public endpoints need no credentials either way)
KALSHI_ENVIRONMENT=demo

# Whether the markets poller runs inside the API process. true | false
MARKETS_POLLER_ENABLED=true
