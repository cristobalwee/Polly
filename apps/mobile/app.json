{
  "expo": {
    "name": "polly",
    "slug": "polly",
    "scheme": "polly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polly.app"
    },
    "android": {
      "package": "com.polly.app",
      "edgeToEdgeEnabled": true
    }
  }
}
